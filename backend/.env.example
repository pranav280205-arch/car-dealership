# Environment variables the API reads (see app/config.py). Every one has a
# working default, so you only need to export the ones you want to change.

# SQLite file by default. For Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership
DATABASE_URL=sqlite:///./dealership.db

# Use a long random string in production, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-please-change-me-0123456789abcdef
TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
